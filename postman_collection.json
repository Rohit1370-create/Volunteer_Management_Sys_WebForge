      "name": "01. Authentication & Profile",
      "item": [
        {
          "name": "Register User (Positive 201 - Forces role=USER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Success envelope and role USER\", function () {",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.user.role).to.eql(\"USER\");",
                  "    pm.expect(json.data.user.password).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kavya Patel\",\n  \"email\": \"kavya_test_\" + Math.floor(Math.random() * 100000) + \"@campus.edu\",\n  \"password\": \"Password123\",\n  \"branch\": \"CSE\",\n  \"section\": \"A\",\n  \"yearOfStudy\": 2,\n  \"role\": \"ADMIN\"\n}"
